APP_ENV=development
APP_NAME=KAI RAMS Authentication API
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/kai_auth
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-another-long-random-secret
JWT_ACCESS_PRIVATE_KEY_B64=
JWT_ACCESS_PUBLIC_KEY_B64=
JWT_ACCESS_KEY_ID=kai-auth-2026-01
JWT_ISSUER=https://kai-rams-backend.vercel.app
JWT_AUDIENCE=kai-rams-api
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_OBSERVATION_WINDOW_MINUTES=15
LOGIN_LOCK_MINUTES=15
LOGIN_IP_RATE_LIMIT=30
LOGIN_IP_RATE_WINDOW_MINUTES=15
REFRESH_IP_RATE_LIMIT=120
REFRESH_IP_RATE_WINDOW_MINUTES=15
REGISTER_IP_RATE_LIMIT=5
REGISTER_IP_RATE_WINDOW_MINUTES=60
CORS_ORIGINS=http://localhost:3000
BOOTSTRAP_ADMIN_USERNAME=operator_kai
